# Copy to .env (repo root or services/api). Everything is optional: with no keys the app runs
# fully in demo mode with simulated payments, simulated extraction and a simulated inbox.

DEMO_MODE=true
# Shared code required at the demo sign-in screen. Leave empty on your own laptop; SET IT before
# sharing a link, because demo sign-in has no passwords and an owner can reset the sample data.
DEMO_ACCESS_CODE=
DATABASE_URL=sqlite:///./data/autopilot.db
# DATABASE_URL=postgresql+psycopg://autopilot:autopilot@localhost:5432/autopilot
UPLOAD_DIR=./data/uploads
WEB_BASE_URL=http://localhost:3000

# Demo payment provider webhook secret (simulated money only). Change it anyway.
DEMO_WEBHOOK_SECRET=demo-webhook-secret-change-me

# Gemini bill extraction + assistant tool routing (google-genai).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Razorpay TEST MODE only. Keys must start with rzp_test_; live keys are refused.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API, inbound only (merchant bill media, customer replies).
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=

# ElevenLabs browser voice agent + its server tools (/v1/voice-tools/*).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
VOICE_TOOL_SECRET=
VOICE_TOOL_MERCHANT_ID=

# Outbound customer messaging gate. Setting this alone enables nothing: a message also needs an
# approved type, channel credentials, a recorded opt-in and merchant approval - and live WhatsApp
# sending is not implemented in this MVP. Collection/overdue reminders are always refused.
OUTBOUND_POLICY_APPROVED=false
OUTBOUND_APPROVED_MESSAGE_TYPES=
